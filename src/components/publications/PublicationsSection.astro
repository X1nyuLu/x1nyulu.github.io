---
import type { ProcessedPublication } from "@/types"

import { PROFILE } from "@site-config"
import { formatCount } from "@/lib/plural"
import { loadAllPublications } from "@/lib/publications/loader"
import { slugify } from "@/lib/string-manipulation"
import Link from "@/components/base/Link.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import Section from "@/components/layout/Section.astro"
import PubCard from "@/components/publications/PubCard.astro"

import "@/styles/chip-filter.css"

const ggScholarUrl =
  typeof PROFILE.links.googleScholar === "object"
    ? PROFILE.links.googleScholar?.href
    : PROFILE.links.googleScholar

const {
  allPublicationsFlat,
  selectedPublications,
  morePublications,
  moreKeywords,
} = await loadAllPublications()

const publicationStructuredData = {
  "@context": "https://schema.org",
  "@graph": allPublicationsFlat.map((pub) => ({
    "@type": "ScholarlyArticle",
    headline: pub.title,
    ...(pub.abstract && { abstract: pub.abstract }),
    ...(pub.year && { datePublished: String(pub.year) }),
    ...(pub.publisher && {
      isPartOf: { "@type": "Periodical", name: pub.publisher },
    }),
    author: pub.authors.map((name) => ({
      "@type": "Person",
      name,
      ...(name.toLowerCase().replace(/-/g, "").includes("xinyu lu") && {
        "@id": new URL("/#person", Astro.site).toString(),
      }),
    })),
    ...(pub.doi && { identifier: pub.doi }),
    ...(pub.mainUrl && { url: pub.mainUrl }),
    ...(pub.image && { image: new URL(pub.image, Astro.site).toString() }),
    ...(pub.keywords.length > 0 && { keywords: pub.keywords.join(", ") }),
  })),
}
---

<Section title="Publications" id="publications" class="publications-section">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(publicationStructuredData)}
  />
  <p class="publication-intro">
    {ggScholarUrl ? (
        <>
          For the complete and current publication record, visit{" "}
          <Link href={ggScholarUrl} external underline class="publication-scholar-link">
            Google Scholar.
          </Link>
        </>
      ) : (
        "Publications and preprints"
      )}
  </p>

  {selectedPublications.length > 0 && (
      <section class="publication-tier" aria-labelledby="selected-publications">
        <div class="publication-tier-heading">
          <div>
            <h3 id="selected-publications">Selected publications</h3>
            <p>Representative work across molecular AI and spectroscopy.</p>
          </div>
          <span class="publication-count">
            {formatCount(selectedPublications.length, "publication")}
          </span>
        </div>

        <CardGroup>
          {selectedPublications.map((pub: ProcessedPublication) => (
            <PubCard
              pub={pub}
              filterableTags={false}
              instance="selected"
            />
          ))}
        </CardGroup>
      </section>
    )}

  {morePublications.length > 0 && (
      <section class="publication-tier" aria-labelledby="more-publications">
        <div class="publication-tier-heading">
          <div>
            <h3 id="more-publications">More publications</h3>
            <p>Additional peer-reviewed work, ordered newest first.</p>
          </div>
          <span class="publication-count">
            {formatCount(morePublications.length, "publication")}
          </span>
        </div>

        {moreKeywords.length > 0 && (
            <div class="pub-controls">
              <div
                class="chip-filter-bar"
                role="group"
                aria-label="Filter more publications by topic"
              >
                {moreKeywords.map(({ keyword, count }) => (
                  <TaxonomyChip
                    label={keyword}
                    count={count}
                    countNoun="publication"
                    data-pub-tag-filter={slugify(keyword)}
                    aria-pressed="false"
                    aria-label={`Filter more publications by ${keyword}; ${formatCount(count, "publication")}`}
                  />
                ))}
                <span class="chip-active-filter" data-active-filter hidden>
                  <TaxonomyChip
                    label="Clear"
                    prefix="×"
                    tone="destructive"
                    data-clear-filter
                    aria-label="Clear publication filter"
                  />
                </span>
                <span
                  class="sr-only"
                  aria-live="polite"
                  aria-atomic="true"
                  data-publication-filter-status
                />
              </div>
            </div>
          )}

        <CardGroup
          separated={false}
          outlined
          class="more-publication-list"
          data-more-publications
        >
          {morePublications.map((pub: ProcessedPublication) => (
            <PubCard
              pub={pub}
              compact
              filterableTags={false}
              instance="more"
            />
          ))}
        </CardGroup>
      </section>
    )}

  {allPublicationsFlat.length === 0 && (
      <div class="empty-state">
        <h3>No publications found</h3>
        <p>No publications yet.</p>
      </div>
    )}
</Section>

<script>
  import { initChipFilter } from "@/lib/chip-filter"

  function initPublicationFilters() {
    const moreList = document.querySelector<HTMLElement>(
      "[data-more-publications]",
    )
    if (!moreList || moreList.dataset.filtersInitialized === "true") return

    moreList.dataset.filtersInitialized = "true"
    initChipFilter({
      itemSelector: ".publication-card",
      itemAttr: "pubKeywords",
      filterButtonSelector: "[data-pub-tag-filter]",
      filterButtonAttr: "pubTagFilter",
      clearButtonSelector: "[data-clear-filter]",
      activeIndicatorSelector: "[data-active-filter]",
      statusSelector: "[data-publication-filter-status]",
      getScope: () => moreList,
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPublicationFilters, {
      once: true,
    })
  } else {
    initPublicationFilters()
  }
  document.addEventListener("astro:page-load", initPublicationFilters)
  document.addEventListener("astro:after-swap", initPublicationFilters)
</script>

<style>
  .publication-intro,
  .publication-tier-heading p,
  .publication-count,
  .empty-state {
    color: var(--muted-foreground);
  }

  .publication-intro,
  .publication-tier-heading p {
    margin: 0;
  }

  .publication-scholar-link {
    color: var(--foreground);
  }

  .publication-tier {
    display: grid;
    gap: var(--space-s);
  }

  .publication-tier + .publication-tier {
    margin-block-start: var(--space-m);
  }

  .publication-tier-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
  }

  .publication-tier-heading > div {
    display: grid;
    gap: var(--space-3xs);
  }

  .publication-tier h3 {
    margin: 0;
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    scroll-margin-block-start: calc(
      var(--header-height, 4rem) +
      var(--space-s)
    );
  }

  .publication-count {
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .pub-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .empty-state {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .empty-state h3 {
    margin-block: 0 var(--space-2xs);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
  }

  .chip-active-filter[hidden] {
    display: none;
  }
</style>
